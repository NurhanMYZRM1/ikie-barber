{
  "name": "aqil",
  "version": "1.0.0",
  "description": "Mobile-first single-owner barber shop management",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "private": true,
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
