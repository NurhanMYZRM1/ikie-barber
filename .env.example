# Copy this file to .env.local. Never put a secret/service-role key here.
# Supabase dashboard → Project Settings → Data API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard → Project Settings → API Keys → Publishable key.
# This key is public by design. Row Level Security protects private records.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Owner login at /admin/login: the owner types this ID and their Supabase password.
# OWNER_EMAIL is the owner account you created in Supabase Auth (README step 4).
# Server-only: never prefix these with NEXT_PUBLIC_. Never put the password here.
OWNER_USERNAME=
OWNER_EMAIL=
